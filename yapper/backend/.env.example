# Copy this file to .env and fill in the two required values.

# REQUIRED: a long random password. The phone app and dashboard use it to log in.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
YAPPER_TOKEN=

# REQUIRED: free key from https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=

# Where recordings and the database are stored (default: ./data)
# YAPPER_DATA_DIR=data

# --- Optional: change engines -------------------------------------------------
# Speech-to-text. whisper-large-v3 is the most accurate for Hindi/Marathi.
# STT_MODEL=whisper-large-v3
# Any OpenAI-compatible server works, e.g. a local faster-whisper server:
# STT_BASE_URL=http://localhost:9000/v1
# STT_API_KEY=

# Models for translation to English and for the minutes, tried in order.
# When one hits its daily free limit the next one is used.
# TRANSLATE_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct
# MOM_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Set to false to skip the English translation of each minute (saves free-tier tokens).
# TRANSLATE=true
