# NotebookLM MCP server configuration.
# Copy to `.env` and fill in the values for your chosen auth mode.
# NEVER commit the filled-in .env or any cookie/secret file.

# ── Auth mode: "cookie" (default) or "oauth" ───────────────────────────────
NOTEBOOKLM_AUTH_MODE=cookie

# ── Cookie / SAPISIDHASH auth (consumer NotebookLM) ────────────────────────
# Option A: paste the raw Cookie header copied from your browser's dev tools
#           while signed in to https://notebooklm.google.com
# NOTEBOOKLM_COOKIE=SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...
#
# Option B: point to an exported cookie file (JSON list, {name:value} JSON,
#           or Netscape cookies.txt). Prefer this over the raw string.
# NOTEBOOKLM_COOKIE_FILE=/absolute/path/to/cookies.json

# ── OAuth 2.0 auth (NotebookLM Enterprise / Agentspace) ────────────────────
# Requires: pip install 'notebooklm-mcp[oauth]'
# NOTEBOOKLM_OAUTH_CLIENT_SECRETS=/absolute/path/to/client_secrets.json
# NOTEBOOKLM_OAUTH_TOKEN_FILE=/absolute/path/to/token.json
# NOTEBOOKLM_OAUTH_SCOPES=https://www.googleapis.com/auth/cloud-platform

# ── Optional overrides ─────────────────────────────────────────────────────
# NOTEBOOKLM_BASE_URL=https://notebooklm.google.com
# NOTEBOOKLM_REQUEST_TIMEOUT=30
